{
  "name": "@hafbit/react-acp",
  "version": "0.1.0",
  "description": "Transport-agnostic ACP v1 runtime adapter for assistant-ui, with React hooks and headless primitives.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hafbit/react-acp.git"
  },
  "homepage": "https://github.com/hafbit/react-acp#readme",
  "bugs": {
    "url": "https://github.com/hafbit/react-acp/issues"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "tsup",
    "docs:check": "node scripts/check-jsr-docs.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "example:build": "pnpm --dir examples/vite build",
    "jsr:check": "jsr publish --dry-run --allow-dirty",
    "pack:check": "npm pack --dry-run",
    "release:test": "node --test scripts/release-test.mjs",
    "release:version": "node scripts/release-version.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:jsr-repair-check": "node scripts/jsr-repair-check.mjs",
    "release:pack": "node scripts/release-pack.mjs",
    "smoke:codex": "node scripts/smoke-agent.mjs codex",
    "smoke:opencode": "node scripts/smoke-agent.mjs opencode",
    "check": "pnpm lint && pnpm typecheck && pnpm docs:check && pnpm test && pnpm release:test && pnpm jsr:check && pnpm build && pnpm example:build && pnpm test:e2e && pnpm pack:check"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@assistant-ui/core": "^0.3.10",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@assistant-ui/react": "^0.15.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.15.0",
    "@playwright/test": "^1.54.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "jsr": "0.14.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
